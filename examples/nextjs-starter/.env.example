# route.ts는 기본으로 claude-api provider를 쓰므로 이 키가 필요합니다.
# https://console.anthropic.com 에서 발급받으세요.
ANTHROPIC_API_KEY=

# 바꾸지 않으면 claude-api. 계속 켜져 있는 서버(VPS 등)에서만 구독 provider로 바꿀 수 있습니다.
# AI_PROVIDER=claude-api

# 선택사항: 서버리스(Vercel 등)에 여러 인스턴스로 배포하면 요청당 rate limit이 메모리 기반이라
# 인스턴스마다 따로 세어져 느슨해집니다. 아래 둘 다 채우면 Upstash Redis(무료 플랜 가능)로
# 정확한 rate limit을 씁니다. https://console.upstash.com 에서 Redis 만들고 REST URL/TOKEN 복사.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
